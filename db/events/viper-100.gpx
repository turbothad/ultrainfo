<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Ultrainfo (converted from the organizer's linked plotaroute course)" xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>Viper 100 course loop</name>
    <desc>One 33.4-mile Shelby Farms Park loop; the 100-mile race runs it three times. Track points copy the organizer-linked plotaroute route 3232103 ("Viper 300 Route 2026" by the Race Director, embedded on the 2027 UltraSignup page as "Viper Course Loop - 33.4 miles"; retrieved 2026-08-14). The loop GPS-measures 33.43 miles with a 23-foot closure. Station waypoints are placed on the track at each station's first published loop mile: Bridge at 7.4 (the 14.4 pass runs 61 feet away), Refuge at 10.8, Tour de Wolf at 20.8 (the 27.0 pass crosses about 0.18 mile away across the pavilion area), and Hyde Lake Pavilion at the loop start/finish. The source route carries no elevations.</desc>
    <link href="https://www.plotaroute.com/route/3232103"><text>Viper course loop on plotaroute</text></link>
  </metadata>
  <wpt lat="35.139407" lon="-89.835925">
    <name>Hyde Lake Pavilion Start/Finish</name>
  </wpt>
