    <name>Bridge Aid Station</name>
  </wpt>
  <wpt lat="35.118313" lon="-89.806644">
    <name>Refuge Aid Station</name>
  </wpt>
  <wpt lat="35.141453" lon="-89.825290">
    <name>Tour de Wolf Aid Station</name>
  </wpt>
