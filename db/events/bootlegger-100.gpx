<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Ultrainfo (converted from the organizer's official GPX download)" xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>Bootlegger 100 course loop</name>
    <desc>One 12.5-mile loop from the Group Shelter at Indian Springs State Park through Dauset Trails; the 100-mile race runs it eight times. Track points and elevations copy the organizer's official GPX download ("Bootlegger Route", the Download GPX File link on the 2027 UltraSignup listing; retrieved 2026-08-13). The loop GPS-measures 12.31 miles with an 18-foot closure against the billed 12.5-mile frame, which governs pass miles. Station waypoints sit on the track at the loop start/finish and at Aid Station 2's published loop mile 6.2.</desc>
    <link href="https://ultrasignup.com/register.aspx?did=137845"><text>Bootlegger 100 2027 listing</text></link>
  </metadata>
  <wpt lat="33.248240" lon="-83.927390">
    <name>Group Shelter Start/Finish</name>
  </wpt>
  <wpt lat="33.238238" lon="-83.952124">
