<% if @race %>
  <section class="mx-auto max-w-[1320px] px-5 py-16 sm:px-8 sm:py-24 lg:py-28">
    <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-pine">Open-source 100-mile race records</p>
    <h1 class="mt-5 max-w-[1120px] break-words font-display text-[clamp(3.5rem,17vw,8.8rem)] font-extrabold uppercase leading-[0.78] tracking-[-0.045em] text-ink">
      Ultra race information. <span class="text-pine">One place.</span>
    </h1>
    <div class="mt-9 flex min-w-0 max-w-4xl flex-col gap-6 border-t border-ink/10 pt-6 sm:flex-row sm:items-end sm:justify-between">
      <p class="min-w-0 max-w-2xl text-base font-medium leading-relaxed text-stone sm:text-lg">
        Schedules, maps, cutoffs, crew access, tracking, and results—organized into one public race record.
      </p>
      <div class="flex shrink-0 flex-wrap items-center gap-4">
        <%= link_to "View #{@race.name}", race_path(@race), class: "inline-flex items-center rounded-md bg-ink px-5 py-3 text-sm font-bold text-white no-underline transition hover:bg-pine focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pine" %>
        <%= link_to "GitHub ↗", "https://github.com/turbothad/ultrainfo", class: "font-mono text-[10px] font-semibold uppercase tracking-[0.1em] text-stone hover:text-ink" %>
      </div>
    </div>
    <p class="mt-6 font-mono text-[9px] uppercase tracking-[0.1em] text-stone-light">Free · No account · Open source · MIT</p>
  </section>

  <section class="border-y border-paper/10 bg-ink text-paper">
    <div class="mx-auto grid max-w-[1320px] gap-8 px-5 py-8 sm:px-8 lg:grid-cols-[0.62fr_1.38fr] lg:items-center lg:gap-12 lg:py-12">
      <div class="min-w-0 py-4 lg:py-0">
        <p class="font-mono text-[9px] font-semibold uppercase tracking-[0.14em] text-paper/45">First complete record · <%= @race.year %></p>
        <h2 class="mt-4 break-words font-display text-[clamp(3rem,15vw,6.8rem)] font-extrabold uppercase leading-[0.8] tracking-[-0.04em] text-paper"><%= @race.name %></h2>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-paper/60">
          <%= @race.blurb %>
        </p>

        <dl class="mt-8 grid grid-cols-2 border-y border-paper/10">
          <% [
            [ "Distance", @race.distance_mi && "#{@race.distance_mi.to_f.round(1)} mi" ],
            [ "Vert", @race.elevation_gain_ft && "#{number_with_delimiter @race.elevation_gain_ft} ft" ],
            [ "Cutoff", @race.cutoff_hours && "#{@race.cutoff_hours.to_i} h" ],
            [ "Station passes", @race.aid_stations.size ]
          ].each do |label, value| %>
            <div class="border-b border-paper/10 py-4 odd:pr-4 even:border-l even:border-paper/10 even:pl-4 nth-[n+3]:border-b-0">
              <dt class="font-mono text-[9px] uppercase tracking-[0.1em] text-paper/35"><%= label %></dt>
              <dd class="mt-1 font-mono text-sm font-semibold text-paper"><%= value.presence || "—" %></dd>
            </div>
          <% end %>
        </dl>

        <%= link_to "Explore the full race record →", race_path(@race), class: "mt-7 inline-flex font-mono text-[10px] font-semibold uppercase tracking-[0.1em] text-[#f4b860] hover:text-paper" %>
      </div>

      <%= render "races/terrain_preview", race: @race %>
    </div>
  </section>

<% else %>
  <section class="mx-auto max-w-[1320px] px-5 py-24 text-stone sm:px-8">No races loaded.</section>
<% end %>
