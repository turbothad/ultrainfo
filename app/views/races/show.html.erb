<%= render "races/race_header", race: @race %>
<%= render "races/jump_nav" %>

<div class="mx-auto max-w-[1240px] px-6 pb-20 sm:px-10">
  <section id="facts" aria-label="Race facts" class="scroll-mt-32 py-14 sm:py-16">
    <%= render "races/stat_grid", stats: [
        [ "Date", race_date_label(@race) ],
        [ "Start", [ @race.start_time, @race.start_venue ].compact.join(" at ") ],
        [ "Finish", @race.finish_venue ],
        [ "Overall cutoff", overall_cutoff_display(@race) ],
        [ "Registration", registration_display(@race) ],
        [ "Lottery", @race.lottery? ? "Yes" : "No" ]
      ] %>

    <p class="mt-4 font-mono text-[11px] text-stone-light">
      All facts from official race materials ·
      <% if @race.source_metadata["verification_status"].in?(%w[warning unverified]) %>
        <span class="font-bold text-rust"><%= source_status_label(@race.source_metadata) %></span> ·
      <% end %>
      <%= (verified_on = latest_verified_on_label(@race.source_metadata)) ? "verified #{verified_on}" : "verification pending" %>
      · <%= link_to "Sources", "#sources", class: "font-semibold text-pine underline-offset-4 hover:text-ink" %>
    </p>
  </section>

  <section id="course" aria-labelledby="course-heading" class="scroll-mt-32 border-t border-ink/10 py-14 sm:py-16">
    <div class="mb-8 max-w-3xl">
      <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-stone-light">Course</div>
      <h2 id="course-heading" class="mt-3 text-3xl font-black uppercase leading-none tracking-tight text-ink sm:text-4xl">Course, terrain, and crew drive.</h2>
      <p class="mt-4 text-base leading-relaxed text-stone">
        The terrain explorer combines the GPX course, aid station markers, and a separate crew driving layer. The elevation profile follows the same official course data.
      </p>
    </div>
    <%= render "races/map", race: @race, drive: true %>
    <div class="mt-8">
      <%= render "races/elevation_profile", race: @race %>
    </div>
  </section>

  <section id="aid-stations" aria-labelledby="aid-stations-heading" class="scroll-mt-32 border-t border-ink/10 py-14 sm:py-16">
    <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-stone-light">Aid stations</div>
        <h2 id="aid-stations-heading" class="mt-3 text-3xl font-black uppercase leading-none tracking-tight text-ink sm:text-4xl">Every station pass and cutoff.</h2>
        <p class="mt-4 text-base leading-relaxed text-stone">
          One complete course-order table covers aid, cutoffs, drop bags, medical checks, crew access, and pacer pickup points.
        </p>
      </div>

      <%= render "races/stat_grid", stats: aid_station_summary_stats(@race) %>
    </div>

    <div class="mt-10">
      <%= render "races/aid_station_table", stations: @race.aid_stations %>
    </div>
  </section>

  <section id="crew" aria-labelledby="crew-heading" class="scroll-mt-32 border-t border-ink/10 py-14 sm:py-16">
    <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-stone-light">Crew &amp; pacers</div>
        <h2 id="crew-heading" class="mt-3 text-3xl font-black uppercase leading-none tracking-tight text-ink sm:text-4xl">Access rules in course context.</h2>
        <p class="mt-4 text-base leading-relaxed text-stone">
          The master aid-station table shows both crew-allowed and no-crew passes, with parking, road, drop-bag, and pacer details. The Course map keeps the crew driving route available as a separate layer.
        </p>
        <%= link_to "Review all station access", "#aid-stations", class: "mt-5 inline-block font-semibold text-pine underline-offset-4 hover:text-ink" %>
      </div>

      <div class="space-y-4">
        <div class="rounded-lg border border-ink/10 bg-card p-5">
          <div class="font-mono text-[11px] uppercase tracking-[0.14em] text-stone-light">Pacer rule summary</div>
          <p class="mt-2 text-sm leading-relaxed text-stone">
            <%= @race.source_metadata["pacer_rule_summary"].presence || "Pacer rules are not listed in the current source data." %>
          </p>
        </div>
        <% if (crew_drive = crew_drive_summary(@race)) %>
          <div class="rounded-lg border border-ink/10 bg-card p-5">
            <div class="font-mono text-[11px] uppercase tracking-[0.14em] text-stone-light">Crew drive</div>
            <p class="mt-2 text-sm leading-relaxed text-stone">
              <%= crew_drive %>.
            </p>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <section id="follow" aria-labelledby="follow-heading" class="scroll-mt-32 border-t border-ink/10 py-14 sm:py-16">
    <div class="max-w-3xl">
      <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-stone-light">Follow</div>
      <h2 id="follow-heading" class="mt-3 text-3xl font-black uppercase leading-none tracking-tight text-ink sm:text-4xl">Follow the race from home.</h2>
      <p class="mt-4 text-base leading-relaxed text-stone">
        Official timing and results for family and friends watching remotely. All clock times use the race's local timezone.
      </p>
    </div>

    <div aria-label="Key race times" class="mt-8 grid gap-px overflow-hidden rounded-lg border border-ink/10 bg-ink/10 md:grid-cols-3">
      <% key_race_times(@race).each do |label, value| %>
        <div class="bg-card p-5">
          <div class="font-mono text-[10px] uppercase tracking-[0.14em] text-stone-light"><%= label %></div>
          <div class="mt-1 font-semibold text-ink"><%= value %></div>
        </div>
      <% end %>
    </div>

    <div class="mt-4 grid gap-4 md:grid-cols-3">
      <div aria-label="Live tracking" class="rounded-lg border border-ink/10 bg-card p-5">
        <div class="font-mono text-[11px] uppercase tracking-[0.14em] text-stone-light">Live tracking</div>
        <% if @race.tracking_url.present? %>
          <%= link_to "Open official tracking", @race.tracking_url, target: "_blank", rel: "noopener",
                class: "mt-2 inline-block font-semibold text-pine no-underline hover:text-ink" %>
        <% else %>
          <p class="mt-2 text-sm leading-relaxed text-stone">Official live tracking is not announced in the current source data.</p>
        <% end %>
      </div>

      <div aria-label="Official results" class="rounded-lg border border-ink/10 bg-card p-5">
        <div class="font-mono text-[11px] uppercase tracking-[0.14em] text-stone-light">Results</div>
        <% if @race.results_url.present? %>
          <%= link_to "Official results", @race.results_url, target: "_blank", rel: "noopener",
                class: "mt-2 inline-block font-semibold text-pine no-underline hover:text-ink" %>
        <% else %>
          <p class="mt-2 text-sm leading-relaxed text-stone">Official results are not listed in the current source data.</p>
        <% end %>
      </div>

      <div aria-label="Finish" class="rounded-lg border border-ink/10 bg-card p-5">
        <div class="font-mono text-[11px] uppercase tracking-[0.14em] text-stone-light">Finish</div>
        <p class="mt-2 text-sm leading-relaxed text-stone"><%= @race.finish_venue.presence || "Finish-line details are not listed in the current source data." %></p>
      </div>
    </div>
  </section>

  <section id="sources" aria-labelledby="sources-heading" class="scroll-mt-32 border-t border-ink/10 py-14 sm:py-16">
    <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-stone-light">Sources</div>
        <h2 id="sources-heading" class="mt-3 text-3xl font-black uppercase leading-none tracking-tight text-ink sm:text-4xl">Official-source record.</h2>
        <p class="mt-4 text-base leading-relaxed text-stone">
          Verification dates, source links, and any warnings behind the planning facts on this page.
        </p>
      </div>
      <div>
        <ol aria-label="Official source documents" class="space-y-3">
          <% Array(@race.source_metadata["sources"]).each do |source| %>
            <li class="rounded-lg border border-ink/10 bg-card p-5">
              <% if source["url"].present? %>
                <%= link_to source["label"], source["url"], target: "_blank", rel: "noopener",
                      class: "font-semibold text-pine underline-offset-4 hover:text-ink" %>
              <% else %>
                <div class="font-semibold text-ink"><%= source["label"] %></div>
              <% end %>

              <div class="mt-1 font-mono text-[11px] uppercase tracking-[0.08em] text-stone-light">
                <% if (verified_on = latest_verified_on_label(source)) %>
                  <time datetime="<%= source["verified_on"] %>">Verified <%= verified_on %></time>
                <% else %>
                  Verification date not listed
                <% end %>
              </div>

              <% if source["notes"].present? %>
                <p class="mt-3 text-sm leading-relaxed text-stone"><%= source["notes"] %></p>
              <% end %>
            </li>
          <% end %>
        </ol>

        <% if @race.source_metadata["notes"].present? %>
          <p class="mt-4 text-sm leading-relaxed text-stone"><%= @race.source_metadata["notes"] %></p>
        <% end %>
      </div>
    </div>
  </section>
</div>
