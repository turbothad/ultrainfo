<header class="mx-auto max-w-[1320px] px-5 pb-8 pt-10 sm:px-8 sm:pb-10 sm:pt-12">
  <p class="font-mono text-[10px] font-medium uppercase tracking-[0.14em] text-pine">
    <%= race.state %><%= " · #{race_date_label(race)}" if race.start_date %>
  </p>
  <div class="mt-2 grid gap-5 lg:grid-cols-[1fr_auto] lg:items-end">
    <div>
      <h1 class="font-display text-[clamp(4.5rem,10vw,8rem)] font-extrabold uppercase leading-[0.76] tracking-[-0.045em] text-ink"><%= race.name %></h1>
      <% if race.blurb.present? %>
        <p class="mt-5 max-w-3xl text-sm font-medium leading-relaxed text-stone sm:text-base"><%= race.blurb %></p>
      <% end %>
    </div>

    <dl class="grid grid-cols-2 border-y border-ink/10 sm:grid-cols-4 lg:min-w-[520px]">
      <% [
        [ "Distance", race.distance_mi && "#{race.distance_mi.to_f.round(1)} mi" ],
        [ "Vert", race.elevation_gain_ft && "#{number_with_delimiter race.elevation_gain_ft} ft" ],
        [ "Cutoff", race.cutoff_hours && "#{cutoff_hours_number(race)} h#{' · disputed' if overall_cutoff_warning(race)}" ],
        [ "Aid stations", race.aid_station_location_count ]
      ].each do |label, value| %>
        <div class="border-b border-ink/10 px-3 py-3 odd:pl-0 even:border-l even:border-ink/10 last:border-b-0 sm:border-b-0 sm:first:pl-0">
          <dt class="data-label"><%= label %></dt>
          <dd class="mt-1 font-mono text-sm font-semibold text-ink"><%= value.presence || "—" %></dd>
        </div>
      <% end %>
    </dl>
  </div>
</header>
