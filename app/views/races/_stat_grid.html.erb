<div class="grid gap-px overflow-hidden rounded-lg border border-ink/10 bg-ink/10 sm:grid-cols-2">
  <% stats.each do |label, value| %>
    <div class="bg-card p-4">
      <div class="font-mono text-[10px] uppercase tracking-[0.14em] text-stone-light"><%= label %></div>
      <div class="mt-1 font-semibold text-ink"><%= value.presence || "Not listed" %></div>
    </div>
  <% end %>
</div>
