<details class="rounded-lg border border-pine/20 bg-card p-5">
  <summary class="cursor-pointer list-none">
    <div class="flex items-start justify-between gap-4">
      <div>
        <div class="font-mono text-[11px] uppercase tracking-[0.14em] text-pine"><%= source_status_label(race.source_metadata) %></div>
        <div class="mt-1 font-semibold text-ink">Official source record</div>
      </div>
      <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-stone-light">Open</span>
    </div>
  </summary>

  <div class="mt-4 space-y-3 border-t border-ink/10 pt-4">
    <% Array(race.source_metadata["sources"]).each do |source| %>
      <div>
        <div class="font-semibold text-ink"><%= source["label"] %></div>
        <div class="mt-1 font-mono text-[11px] text-stone">
          <%= [ source["verified_on"] && "verified #{source["verified_on"]}", source["fetched_on"] && "fetched #{source["fetched_on"]}" ].compact.join(" / ") %>
        </div>
        <% if source["url"].present? %>
          <%= link_to source["url"], source["url"], target: "_blank", rel: "noopener", class: "mt-1 block break-all text-sm font-medium text-pine hover:text-ink" %>
        <% end %>
      </div>
    <% end %>
    <% if race.source_metadata["notes"].present? %>
      <p class="text-sm leading-relaxed text-stone"><%= race.source_metadata["notes"] %></p>
    <% end %>
  </div>
</details>
