<div class="overflow-x-auto rounded-lg border border-ink/10 bg-card">
  <table class="w-full border-collapse text-left text-sm">
    <thead class="font-mono text-[10px] uppercase tracking-[0.12em] text-stone-light">
      <tr class="border-b border-ink/10">
        <th class="px-4 py-3">Mile</th>
        <th class="px-4 py-3">Pass</th>
        <th class="px-4 py-3">Aid station</th>
        <th class="px-4 py-3">Cutoff</th>
        <th class="px-4 py-3 text-center">Crew</th>
        <th class="px-4 py-3 text-center">Drop bag</th>
        <th class="px-4 py-3 text-center">Pacer</th>
        <th class="px-4 py-3">Access notes</th>
      </tr>
    </thead>
    <tbody>
      <% stations.each do |s| %>
        <tr class="border-b border-ink/5 last:border-0">
          <td class="whitespace-nowrap px-4 py-3 font-mono font-semibold"><%= s.mile %></td>
          <td class="whitespace-nowrap px-4 py-3 font-mono text-[11px] uppercase tracking-[0.08em] text-stone"><%= s.direction.presence || "—" %></td>
          <td class="min-w-64 px-4 py-3">
            <details>
              <summary class="cursor-pointer font-semibold text-ink"><%= s.name %></summary>
              <div class="mt-3 space-y-2 text-sm leading-relaxed text-stone">
                <% [
                  [ "Elevation", s.elevation_ft && "#{number_with_delimiter s.elevation_ft} ft" ],
                  [ "Aid", s.aid_notes ],
                  [ "Medical", s.has_medical? ? "Medical check listed" : nil ],
                  [ "Bathrooms", s.bathroom_notes ],
                  [ "Crew", s.crew_access_notes ],
                  [ "Pacer", s.pacer_notes ],
                  [ "Road", s.road_notes ],
                  [ "Source", source_status_label(s.source_metadata) ]
                ].each do |label, value| %>
                  <% next if value.blank? %>
                  <div><span class="font-mono text-[10px] uppercase tracking-[0.12em] text-stone-light"><%= label %>:</span> <%= value %></div>
                <% end %>
                <% if (destination = directions_destination(s)) %>
                  <%= link_to "Directions", "https://www.google.com/maps/dir/?api=1&destination=#{destination}", target: "_blank", rel: "noopener", class: "font-semibold text-pine hover:text-ink" %>
                <% end %>
              </div>
            </details>
          </td>
          <td class="whitespace-nowrap px-4 py-3 font-mono text-stone"><%= cutoff_display(s) %></td>
          <td class="px-4 py-3 text-center"><%= yes_no s.crew_accessible %></td>
          <td class="px-4 py-3 text-center"><%= yes_no s.drop_bag %></td>
          <td class="px-4 py-3 text-center"><%= yes_no s.pacer_access %></td>
          <td class="min-w-72 px-4 py-3 text-stone"><%= s.parking_notes.presence || s.crew_access_notes.presence || "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
