<% initial_filter = local_assigns.fetch(:initial_filter, "all").presence_in(%w[all crew drop pacer]) || "all" %>
<div id="station-pass-table"
     data-controller="station-filter"
     data-station-filter-initial-value="<%= initial_filter %>">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap gap-2" role="group" aria-label="Filter station passes">
      <% [ [ "All", "all" ], [ "Crew access", "crew" ], [ "Drop bags", "drop" ], [ "Pacer pickup", "pacer" ] ].each do |label, filter| %>
        <button type="button"
                class="station-filter rounded-md border border-ink/15 px-3 py-2 font-mono text-[9px] font-semibold uppercase tracking-[0.08em] text-stone transition hover:border-pine hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pine"
                data-station-filter-target="button"
                data-station-filter-filter-param="<%= filter %>"
                data-action="station-filter#filter"
                aria-pressed="<%= initial_filter == filter %>"><%= label %></button>
      <% end %>
    </div>
    <p data-station-filter-target="status" aria-live="polite" class="font-mono text-[9px] uppercase tracking-[0.08em] text-stone-light">
      Showing <%= station_passes.size %> station passes
    </p>
  </div>

  <div class="border border-ink/10 bg-card">
    <table class="block w-full border-collapse text-left text-sm xl:table xl:table-fixed">
      <colgroup class="hidden xl:table-column-group">
        <col class="w-[9%]">
        <col class="w-[17%]">
        <col class="w-[28%]">
        <col class="w-[12%]">
        <col class="w-[21%]">
        <col class="w-[13%]">
      </colgroup>
      <thead class="sr-only bg-pine-dark font-mono text-[9px] uppercase tracking-[0.1em] text-paper/65 xl:not-sr-only xl:table-header-group">
        <tr class="border-b border-ink/10">
          <th scope="col" class="px-4 py-3">Pass</th>
          <th scope="col" class="px-4 py-3">Aid station</th>
          <th scope="col" class="px-4 py-3">Aid & water</th>
          <th scope="col" class="px-4 py-3">Crew & bags</th>
          <th scope="col" class="px-4 py-3">Next marker</th>
          <th scope="col" class="px-4 py-3">Timing</th>
        </tr>
      </thead>
      <tbody class="block w-full xl:table-row-group">
        <% station_passes.each do |station_pass| %>
          <% features = station_pass[:features].index_by { |feature| feature[:key] } %>
          <tr id="<%= station_pass[:details_id] %>"
              class="grid w-full scroll-mt-24 grid-cols-6 gap-x-3 border-b border-ink/10 px-4 py-3 last:border-0 xl:table-row xl:p-0"
              data-station-filter-target="row"
              data-filter-tags="<%= station_pass[:filter_tags].join(" ") %>"
              data-crew="<%= features.fetch("crew")[:available] %>"
              data-drop="<%= features.fetch("drop_bag")[:available] %>"
              data-pacer="<%= features.fetch("pacer")[:available] %>">
            <td class="col-span-2 py-2 align-top xl:table-cell xl:px-4 xl:py-4">
              <span aria-hidden="true" class="data-label mb-1 block xl:hidden">Pass</span>
              <span class="block font-mono text-base font-semibold text-ink"><%= station_pass[:mile] %></span>
              <span class="mt-1 block font-mono text-[9px] uppercase tracking-[0.08em] text-stone"><%= station_pass[:direction_label] %></span>
            </td>
            <td class="col-span-4 py-2 align-top xl:table-cell xl:px-4 xl:py-4">
              <span aria-hidden="true" class="data-label mb-1 block xl:hidden">Aid station</span>
              <details id="station-pass-<%= station_pass[:sequence] %>" class="scroll-mt-24">
                <summary class="cursor-pointer font-semibold text-ink"><%= station_pass[:name] %></summary>
                <div class="mt-3 space-y-2 text-sm leading-relaxed text-stone">
                  <% station_pass[:details].each do |detail| %>
                    <div>
                      <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-stone-light"><%= detail[:label] %>:</span>
                      <%= detail[:value] %><% if detail[:link] %><%= " · " if detail[:value].present? %><%= link_to detail[:link][:label], detail[:link][:url], target: "_blank", rel: "noopener", class: "font-semibold text-pine underline-offset-4 hover:text-ink" %><% end %>
                    </div>
                  <% end %>
                </div>
              </details>
            </td>
            <td class="col-span-6 border-t border-ink/5 py-3 align-top xl:table-cell xl:border-t-0 xl:px-4 xl:py-4">
              <span aria-hidden="true" class="data-label mb-1 block xl:hidden">Aid & water</span>
              <p class="leading-relaxed text-stone"><%= station_pass[:aid] || "Not listed" %></p>
              <dl class="mt-2 grid gap-1">
                <div class="flex items-baseline gap-2">
                  <dt class="font-mono text-[9px] uppercase tracking-[0.08em] text-stone-light">Water listed</dt>
                  <dd><%= availability_tag station_pass[:water_label] %></dd>
                </div>
                <div class="flex items-baseline gap-2">
                  <dt class="font-mono text-[9px] uppercase tracking-[0.08em] text-stone-light">Potable</dt>
                  <dd><%= availability_tag station_pass[:potable_water_label] %></dd>
                </div>
              </dl>
            </td>
            <td class="col-span-6 py-2 align-top xl:table-cell xl:px-4 xl:py-4">
              <span aria-hidden="true" class="data-label mb-2 block xl:hidden">Crew & bags</span>
              <div class="grid grid-cols-2 gap-x-4 gap-y-2 xl:grid-cols-1">
                <p class="flex items-center justify-between gap-2 xl:justify-start">
                  <span class="font-mono text-[9px] uppercase tracking-[0.08em] text-stone-light">Crew</span>
                  <%= yes_no features.fetch("crew")[:available] %>
                </p>
                <p class="flex items-center justify-between gap-2 xl:justify-start">
                  <span class="font-mono text-[9px] uppercase tracking-[0.08em] text-stone-light">Bag</span>
                  <%= availability_tag features.fetch("drop_bag")[:value] %>
                </p>
              </div>
            </td>
            <td class="col-span-6 my-2 border-l-2 border-flame bg-paper/70 px-3 py-2 align-top xl:my-0 xl:table-cell xl:px-4 xl:py-4">
              <span aria-hidden="true" class="data-label mb-1 block xl:hidden">Next marker</span>
              <% if station_pass[:next_station_pass] %>
                <span class="block font-semibold text-ink"><%= station_pass.dig(:next_station_pass, :name) %></span>
                <span class="mt-1 block font-mono text-[10px] leading-relaxed text-stone"><%= station_pass.dig(:next_station_pass, :label) %></span>
              <% else %>
                <span class="font-mono text-[10px] font-semibold uppercase tracking-[0.08em] text-pine">Course complete</span>
              <% end %>
            </td>
            <td class="col-span-6 py-2 align-top xl:table-cell xl:px-4 xl:py-4">
              <span aria-hidden="true" class="data-label mb-2 block xl:hidden">Timing</span>
              <p>
                <span class="block font-mono text-[9px] uppercase tracking-[0.08em] text-stone-light">Cutoff</span>
                <span class="mt-1 block font-mono text-[11px] text-stone"><%= station_pass[:cutoff_label] %></span>
              </p>
              <p class="mt-2">
                <span class="block font-mono text-[9px] uppercase tracking-[0.08em] text-stone-light">Checked</span>
                <span class="mt-1 block font-mono text-[10px] text-stone"><%= latest_verified_on_label(station_pass[:source_metadata]) || "Not verified" %></span>
              </p>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
