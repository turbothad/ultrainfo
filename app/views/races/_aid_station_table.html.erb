<% initial_filter = local_assigns.fetch(:initial_filter, "all").presence_in(%w[all crew drop pacer]) || "all" %>
<div data-controller="station-filter"
     data-action="race:show-crew-passes@window->station-filter#showCrew"
     data-station-filter-initial-value="<%= initial_filter %>">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap gap-2" role="group" aria-label="Filter station passes">
      <% [ [ "All", "all" ], [ "Crew access", "crew" ], [ "Drop bags", "drop" ], [ "Pacer points", "pacer" ] ].each do |label, filter| %>
        <button type="button"
                class="station-filter rounded-md border border-ink/15 px-3 py-2 font-mono text-[9px] font-semibold uppercase tracking-[0.08em] text-stone transition hover:border-pine hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pine"
                data-station-filter-target="button"
                data-station-filter-filter-param="<%= filter %>"
                data-action="station-filter#filter"
                aria-pressed="<%= initial_filter == filter %>"><%= label %></button>
      <% end %>
    </div>
    <p data-station-filter-target="status" aria-live="polite" class="font-mono text-[9px] uppercase tracking-[0.08em] text-stone-light">
      Showing <%= stations.size %> station passes
    </p>
  </div>

  <div class="overflow-x-auto border border-ink/10 bg-card">
    <table class="w-full border-collapse text-left text-sm">
      <thead class="bg-paper/70 font-mono text-[9px] uppercase tracking-[0.08em] text-stone-light">
        <tr class="border-b border-ink/10">
          <th scope="col" class="px-4 py-3">Mile</th>
          <th scope="col" class="px-4 py-3">Pass</th>
          <th scope="col" class="px-4 py-3">Aid station</th>
          <th scope="col" class="px-4 py-3">Cutoff</th>
          <th scope="col" class="px-4 py-3 text-center">Crew</th>
          <th scope="col" class="px-4 py-3 text-center">Drop bag</th>
          <th scope="col" class="px-4 py-3 text-center">Pacer</th>
          <th scope="col" class="px-4 py-3 text-center">Medical</th>
          <th scope="col" class="px-4 py-3">Access notes</th>
        </tr>
      </thead>
      <tbody>
        <% stations.sort_by { |station| station.sequence || 0 }.each do |s| %>
          <tr id="<%= dom_id(s, :station_pass) %>"
              class="scroll-mt-24 border-b border-ink/5 last:border-0"
              data-station-filter-target="row"
              data-filter-tags="<%= [ ("crew" if s.crew_accessible?), ("drop" if s.drop_bag?), ("pacer" if s.pacer_access?) ].compact.join(" ") %>"
              data-crew="<%= s.crew_accessible? %>"
              data-drop="<%= s.drop_bag? %>"
              data-pacer="<%= s.pacer_access? %>">
            <td class="whitespace-nowrap px-4 py-3 font-mono font-semibold"><%= s.mile %></td>
            <td class="whitespace-nowrap px-4 py-3 font-mono text-[11px] uppercase tracking-[0.08em] text-stone"><%= s.direction.presence || "—" %></td>
            <td class="min-w-64 px-4 py-3">
              <details id="station-pass-<%= s.sequence %>" class="scroll-mt-24">
                <summary class="cursor-pointer font-semibold text-ink"><%= s.name %></summary>
                <div class="mt-3 space-y-2 text-sm leading-relaxed text-stone">
                  <% aid_station_detail_rows(s).each do |label, value| %>
                    <div><span class="font-mono text-[10px] uppercase tracking-[0.12em] text-stone-light"><%= label %>:</span> <%= value %></div>
                  <% end %>
                </div>
              </details>
            </td>
            <td class="whitespace-nowrap px-4 py-3 font-mono text-stone"><%= cutoff_display(s) %></td>
            <td class="px-4 py-3 text-center"><%= yes_no s.crew_accessible %></td>
            <td class="px-4 py-3 text-center"><%= yes_no s.drop_bag %></td>
            <td class="px-4 py-3 text-center"><%= yes_no s.pacer_access %></td>
            <td class="px-4 py-3 text-center"><%= yes_no s.has_medical %></td>
            <td class="min-w-72 px-4 py-3 text-stone"><%= s.parking_notes.presence || s.crew_access_notes.presence || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
