<% initial_filter = local_assigns.fetch(:initial_filter, "all").presence_in(%w[all crew drop pacer]) || "all" %>
<div id="station-pass-table"
     data-controller="station-filter"
     data-station-filter-initial-value="<%= initial_filter %>">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap gap-2" role="group" aria-label="Filter station passes">
      <% [ [ "All", "all" ], [ "Crew access", "crew" ], [ "Drop bags", "drop" ], [ "Pacer points", "pacer" ] ].each do |label, filter| %>
        <button type="button"
                class="station-filter rounded-md border border-ink/15 px-3 py-2 font-mono text-[9px] font-semibold uppercase tracking-[0.08em] text-stone transition hover:border-pine hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pine"
                data-station-filter-target="button"
                data-station-filter-filter-param="<%= filter %>"
                data-action="station-filter#filter"
                aria-pressed="<%= initial_filter == filter %>"><%= label %></button>
      <% end %>
    </div>
    <p data-station-filter-target="status" aria-live="polite" class="font-mono text-[9px] uppercase tracking-[0.08em] text-stone-light">
      Showing <%= station_passes.size %> station passes
    </p>
  </div>

  <div class="overflow-x-auto border border-ink/10 bg-card">
    <table class="w-full border-collapse text-left text-sm">
      <thead class="bg-paper/70 font-mono text-[9px] uppercase tracking-[0.08em] text-stone-light">
        <tr class="border-b border-ink/10">
          <th scope="col" class="px-4 py-3">Mile</th>
          <th scope="col" class="px-4 py-3">Pass</th>
          <th scope="col" class="px-4 py-3">Aid station</th>
          <th scope="col" class="px-4 py-3">Cutoff</th>
          <% Array(station_passes.first&.fetch(:features)).each do |feature| %>
            <th scope="col" class="px-4 py-3 text-center"><%= feature[:label] %></th>
          <% end %>
          <th scope="col" class="px-4 py-3">Access notes</th>
        </tr>
      </thead>
      <tbody>
        <% station_passes.each do |station_pass| %>
          <% features = station_pass[:features].index_by { |feature| feature[:key] } %>
          <tr id="<%= station_pass[:details_id] %>"
              class="scroll-mt-24 border-b border-ink/5 last:border-0"
              data-station-filter-target="row"
              data-filter-tags="<%= station_pass[:filter_tags].join(" ") %>"
              data-crew="<%= features.fetch("crew")[:available] %>"
              data-drop="<%= features.fetch("drop_bag")[:available] %>"
              data-pacer="<%= features.fetch("pacer")[:available] %>">
            <td class="whitespace-nowrap px-4 py-3 font-mono font-semibold"><%= station_pass[:mile] %></td>
            <td class="whitespace-nowrap px-4 py-3 font-mono text-[11px] uppercase tracking-[0.08em] text-stone"><%= station_pass[:direction_label] %></td>
            <td class="min-w-64 px-4 py-3">
              <details id="station-pass-<%= station_pass[:sequence] %>" class="scroll-mt-24">
                <summary class="cursor-pointer font-semibold text-ink"><%= station_pass[:name] %></summary>
                <div class="mt-3 space-y-2 text-sm leading-relaxed text-stone">
                  <% station_pass[:details].each do |detail| %>
                    <div>
                      <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-stone-light"><%= detail[:label] %>:</span>
                      <%= detail[:value] %><% if detail[:link] %><%= " · " if detail[:value].present? %><%= link_to detail[:link][:label], detail[:link][:url], target: "_blank", rel: "noopener", class: "font-semibold text-pine underline-offset-4 hover:text-ink" %><% end %>
                    </div>
                  <% end %>
                </div>
              </details>
            </td>
            <td class="whitespace-nowrap px-4 py-3 font-mono text-stone"><%= station_pass[:cutoff_label] %></td>
            <% station_pass[:features].each do |feature| %>
              <td class="px-4 py-3 text-center"><%= yes_no feature[:available] %></td>
            <% end %>
            <td class="min-w-72 px-4 py-3 text-stone"><%= station_pass[:access_notes] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
