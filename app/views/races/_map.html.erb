<% drive = local_assigns.fetch(:drive, false) && race.crew_route.present? %>
<div id="race-terrain-map"
     data-controller="terrain-map"
     data-terrain-map-url-value="<%= map_race_path(race, format: :json) %>"
     data-terrain-map-drive-value="<%= drive %>"
     class="overflow-hidden rounded-xl border border-ink/10 bg-pine-dark text-paper shadow-[0_28px_60px_-40px_rgba(18,24,21,0.65)]">
  <div class="grid lg:grid-cols-[1fr_300px]">
    <div class="relative min-h-[480px] sm:min-h-[560px]">
      <div data-terrain-map-target="canvas" role="img" aria-label="Interactive three-dimensional terrain map of the <%= race.name %> course, colored by grade, and station passes" class="h-[480px] w-full bg-pine-dark sm:h-[560px]"></div>
      <div data-terrain-map-target="fallback" hidden class="absolute inset-0 z-10 flex items-center justify-center bg-pine-dark px-6 text-center">
        <div class="max-w-sm">
          <div class="font-semibold text-paper">Terrain preview unavailable</div>
          <p class="mt-2 text-sm leading-relaxed text-paper/78">The elevation profile and station table remain available below.</p>
          <a href="#aid-stations" class="mt-4 inline-block font-semibold text-[#f2d77b] hover:text-paper">Browse station passes</a>
        </div>
      </div>
      <div class="absolute left-3 top-3 flex flex-wrap gap-1 rounded-md border border-paper/10 bg-pine-dark/85 p-1.5 font-mono text-[9px] uppercase tracking-[0.08em] backdrop-blur">
        <label class="flex cursor-pointer items-center gap-2 px-2 py-1.5">
          <input type="checkbox" checked data-action="terrain-map#toggleCourse" class="accent-pine">
          Course
        </label>
        <label class="flex cursor-pointer items-center gap-2 px-2 py-1.5">
          <input type="checkbox" checked data-action="terrain-map#toggleStationPasses" class="accent-pine">
          Station passes
        </label>
        <% if drive %>
          <label class="flex cursor-pointer items-center gap-2 px-2 py-1.5">
            <input type="checkbox" checked data-terrain-map-target="driveToggle" data-action="terrain-map#toggleDrive" class="accent-pine">
            Crew drive
          </label>
        <% end %>
      </div>

      <%= render "races/course_grade_legend", stacked: true %>

      <div class="absolute right-3 top-16 flex gap-1.5 font-mono text-[9px] font-medium uppercase tracking-[0.08em] sm:top-3">
        <button type="button" data-action="terrain-map#topView" class="rounded-md border border-paper/15 bg-pine-dark/85 px-3 py-2 text-paper backdrop-blur transition hover:bg-paper hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper">Top view</button>
        <button type="button" data-action="terrain-map#resetView" class="rounded-md border border-paper/15 bg-pine-dark/85 px-3 py-2 text-paper backdrop-blur transition hover:bg-paper hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper">Reset view</button>
      </div>

      <div data-terrain-map-target="status" aria-live="polite" class="absolute bottom-3 left-3 right-3 rounded-md border border-paper/10 bg-pine-dark/85 px-3 py-2 font-mono text-[9px] uppercase tracking-[0.08em] text-paper/65 backdrop-blur">
        Loading terrain
      </div>
    </div>

    <aside class="border-t border-paper/10 bg-[#0b241a] p-5 lg:border-l lg:border-t-0">
      <div class="font-mono text-[9px] uppercase tracking-[0.1em] text-paper/45">Course detail</div>
      <div data-terrain-map-target="detail" class="mt-3 text-sm leading-relaxed text-paper/78">
        <p class="font-semibold text-paper">Select a station pass</p>
        <dl class="mt-4 grid grid-cols-2 gap-3">
          <div>
            <dt class="font-mono text-[9px] uppercase tracking-[0.08em] text-paper/40">Distance</dt>
            <dd class="mt-1 font-mono text-xs font-semibold text-paper"><%= race.distance_mi.to_f.round(1) %> mi</dd>
          </div>
          <div>
            <dt class="font-mono text-[9px] uppercase tracking-[0.08em] text-paper/40">Station passes</dt>
            <dd class="mt-1 font-mono text-xs font-semibold text-paper"><%= race.aid_stations.size %></dd>
          </div>
          <div>
            <dt class="font-mono text-[9px] uppercase tracking-[0.08em] text-paper/40">Crew access</dt>
            <dd class="mt-1 font-mono text-xs font-semibold text-paper"><%= race.aid_stations.count(&:crew_accessible?) %></dd>
          </div>
          <div>
            <dt class="font-mono text-[9px] uppercase tracking-[0.08em] text-paper/40">Final cutoff</dt>
            <dd class="mt-1 font-mono text-xs font-semibold text-paper"><%= race.cutoff_hours.to_i %> h<%= " · disputed" if overall_cutoff_warning(race) %></dd>
          </div>
        </dl>
      </div>
    </aside>
  </div>

  <div class="border-t border-paper/10 bg-[#0b241a] px-3 py-3">
    <div class="mb-3 flex items-center justify-between gap-4">
      <p class="font-mono text-[9px] uppercase tracking-[0.1em] text-paper/45">Station passes</p>
      <p class="hidden font-mono text-[9px] uppercase tracking-[0.08em] text-paper/35 sm:block">Drag · zoom · select</p>
    </div>
    <ol class="flex gap-2 overflow-x-auto pb-2">
      <% station_passes.each do |station_pass| %>
        <li>
          <button type="button"
                  data-terrain-map-target="stationPassButton"
                  data-terrain-map-sequence-param="<%= station_pass[:sequence] %>"
                  data-action="terrain-map#selectStationPassBySequence"
                  aria-pressed="false"
                  class="group min-w-32 rounded-md border border-paper/10 bg-paper/5 px-3 py-2.5 text-left transition hover:border-paper/30 hover:bg-paper/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper">
            <span class="block font-mono text-[8px] uppercase tracking-[0.08em] text-paper/40">Mile <%= station_pass[:mile] %> · <%= station_pass[:direction_label] %></span>
            <span class="mt-1 block text-xs font-bold text-paper"><%= station_pass[:name] %></span>
          </button>
        </li>
      <% end %>
    </ol>
  </div>
</div>
