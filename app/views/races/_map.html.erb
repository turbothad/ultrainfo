<% drive = local_assigns.fetch(:drive, false) && race.crew_route.present? %>
<% wide = local_assigns.fetch(:wide, true) %>
<div data-controller="terrain-map"
     data-terrain-map-url-value="<%= map_race_path(race, format: :json) %>"
     data-terrain-map-drive-value="<%= drive %>"
     class="overflow-hidden rounded-lg border border-ink/10 bg-pine-dark text-paper">
  <div class="<%= wide ? 'grid lg:grid-cols-[1fr_320px]' : '' %>">
    <div class="relative min-h-[540px]">
      <div data-terrain-map-target="canvas" class="h-[540px] w-full bg-pine-dark"></div>
      <div class="absolute left-4 top-4 flex flex-wrap gap-2 rounded-md border border-paper/10 bg-pine-dark/80 p-2 font-mono text-[10px] uppercase tracking-[0.12em] backdrop-blur">
        <label class="flex cursor-pointer items-center gap-2 px-2 py-1">
          <input type="checkbox" checked data-action="terrain-map#toggleCourse" class="accent-pine">
          Course
        </label>
        <label class="flex cursor-pointer items-center gap-2 px-2 py-1">
          <input type="checkbox" checked data-action="terrain-map#toggleStations" class="accent-pine">
          Stations
        </label>
        <% if drive %>
          <label class="flex cursor-pointer items-center gap-2 px-2 py-1">
            <input type="checkbox" checked data-action="terrain-map#toggleDrive" class="accent-pine">
            Crew drive
          </label>
        <% end %>
      </div>
      <div data-terrain-map-target="status" class="absolute bottom-4 left-4 right-4 rounded-md border border-paper/10 bg-pine-dark/80 px-3 py-2 font-mono text-[10px] uppercase tracking-[0.12em] text-paper/80 backdrop-blur">
        Loading terrain
      </div>
    </div>

    <aside class="border-t border-paper/10 bg-[#10291d] p-5 <%= 'lg:border-l lg:border-t-0' if wide %>">
      <div class="font-mono text-[10px] uppercase tracking-[0.14em] text-paper/50">Selected station</div>
      <div data-terrain-map-target="detail" class="mt-3 text-sm leading-relaxed text-paper/78">
        Select an aid station marker to see cutoff, crew, pacer, drop bag, parking, and source details.
      </div>
    </aside>
  </div>
</div>
