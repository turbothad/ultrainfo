<% content_for :head do %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<% end %>
<div class="relative overflow-hidden rounded-xl border border-ink/10 bg-card shadow-[0_24px_60px_-36px_rgba(18,24,21,0.45)]">
  <div data-controller="map" data-map-url-value="<%= map_race_path(race, format: :json) %>">
    <div data-map-target="canvas" class="h-[420px] w-full sm:h-[520px]"></div>
  </div>

  <div class="pointer-events-none absolute left-3 top-3 z-[450] rounded-md border border-ink/10 bg-white/90 px-3 py-2 backdrop-blur">
    <span class="font-mono text-[9px] font-semibold uppercase tracking-[0.12em] text-stone">2026 course</span>
  </div>

  <div class="pointer-events-none absolute inset-x-3 bottom-3 z-[450] flex items-center justify-between rounded-md border border-ink/10 bg-white/90 px-3 py-2 font-mono text-[9px] uppercase tracking-[0.08em] text-stone backdrop-blur">
    <span><%= race.aid_stations.size %> station passes</span>
    <span><%= race.aid_stations.count(&:crew_accessible?) %> crew access</span>
  </div>
</div>
