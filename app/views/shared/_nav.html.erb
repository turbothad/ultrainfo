<header class="sticky top-0 z-50 border-b border-ink/10 bg-paper/90 backdrop-blur-md">
  <div class="mx-auto flex h-14 max-w-[1320px] items-center justify-between gap-6 px-5 sm:px-8">
    <%= link_to root_path, class: "flex items-center gap-2 no-underline" do %>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M1.5 20.5L9 6.5l3.6 6.4L15 8.5l7.5 12H1.5z" fill="#121815"/>
        <path d="M12.6 12.9L15 8.5l7.5 12h-9.4l-2.3-4.2z" fill="#E86137"/>
      </svg>
      <span class="font-display text-xl font-extrabold uppercase tracking-[-0.02em] text-ink">Ultra<span class="text-flame">info</span></span>
    <% end %>
    <nav class="hidden items-center gap-6 font-mono text-[10px] font-medium uppercase tracking-[0.1em] text-stone sm:flex">
      <% if featured_race %>
        <%= link_to "Race", race_path(featured_race), class: "no-underline hover:text-ink" %>
        <%= link_to "Crew", race_path(featured_race, anchor: "crew"), class: "no-underline hover:text-flame" %>
        <%= link_to "Follow", race_path(featured_race, anchor: "follow"), class: "no-underline hover:text-flame" %>
      <% end %>
      <a href="https://github.com/turbothad/ultrainfo" class="no-underline hover:text-ink">GitHub</a>
    </nav>
  </div>
</header>
