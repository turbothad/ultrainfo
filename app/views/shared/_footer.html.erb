<footer id="about" class="border-t border-paper/10 bg-ink text-paper/70">
  <div class="mx-auto max-w-[1320px] px-5 py-8 sm:px-8">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-4">
        <span class="font-display text-xl font-bold uppercase tracking-[-0.02em] text-paper">Ultrainfo</span>
        <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-paper/45">Free · Open source · MIT</span>
      </div>
      <nav class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-[10px] uppercase tracking-[0.1em]">
        <% if featured_race %>
          <%= link_to "Bighorn 100", race_path(featured_race), class: "hover:text-white" %>
        <% end %>
        <a href="https://github.com/turbothad/ultrainfo/issues/new/choose" class="hover:text-white">Report a correction</a>
        <a href="https://github.com/turbothad/ultrainfo" class="hover:text-white">GitHub</a>
      </nav>
    </div>
    <p class="mt-5 border-t border-paper/10 pt-4 font-mono text-[9px] uppercase tracking-[0.08em] text-paper/35">Terrain: Mapzen / Tilezen via AWS Open Data · Three.js</p>
  </div>
</footer>
