#!/usr/bin/env bash

set -Eeuo pipefail

readonly production_host="${1:-87.99.128.125}"
readonly repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly bootstrap_source="${repository_root}/ops/server"
readonly onepassword_agent="${HOME}/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

if [[ ! -S "${onepassword_agent}" ]]; then
  echo "1Password SSH agent is unavailable: ${onepassword_agent}" >&2
  exit 1
fi

export SSH_AUTH_SOCK="${onepassword_agent}"

temporary_directory="$(mktemp -d "${TMPDIR:-/tmp}/ultrainfo-bootstrap.XXXXXX")"
cleanup() {
  rm -rf -- "${temporary_directory}"
}
trap cleanup EXIT

if ! ssh-add -L | awk '$3 == "ultrainfo" { print; found = 1 } END { exit !found }' > "${temporary_directory}/ultrainfo.pub"; then
  echo "The 1Password SSH agent does not expose a key named 'ultrainfo'." >&2
  exit 1
fi

readonly -a ssh_options=(
  -o BatchMode=yes
  -o ConnectTimeout=10
  -o IdentitiesOnly=no
  -o StrictHostKeyChecking=yes
)

echo "Uploading secret-free bootstrap files to ${production_host}..."
ssh "${ssh_options[@]}" "root@${production_host}" "install -d -m 0700 /tmp/ultrainfo-bootstrap"
scp "${ssh_options[@]}" \
  "${temporary_directory}/ultrainfo.pub" \
  "${bootstrap_source}/bootstrap.sh" \
  "${bootstrap_source}/docker-daemon.json" \
  "${bootstrap_source}/fail2ban-sshd.local" \
  "${bootstrap_source}/sshd-hardening.conf" \
  "${bootstrap_source}/unattended-upgrades.conf" \
  "${bootstrap_source}/verify-host.sh" \
  "root@${production_host}:/tmp/ultrainfo-bootstrap/"

echo "Preparing the host and deployment user..."
ssh "${ssh_options[@]}" "root@${production_host}" \
  "/tmp/ultrainfo-bootstrap/bootstrap.sh prepare"

echo "Verifying deployment-user access before disabling root SSH..."
ssh "${ssh_options[@]}" "deploy@${production_host}" \
  "test \"\$(id -un)\" = deploy && docker info >/dev/null && sudo -n true"

echo "Applying SSH hardening..."
ssh "${ssh_options[@]}" "root@${production_host}" \
  "/tmp/ultrainfo-bootstrap/bootstrap.sh harden-ssh"

echo "Verifying hardened deployment-user access..."
ssh "${ssh_options[@]}" "deploy@${production_host}" \
  "test \"\$(id -un)\" = deploy && docker info >/dev/null && sudo -n true"

if ssh "${ssh_options[@]}" "root@${production_host}" true 2>/dev/null; then
  echo "Root SSH is still available after hardening." >&2
  exit 1
fi

echo "Host bootstrap and SSH hardening succeeded."
