# Optional shell overrides.
OP_VAULT=$OP_VAULT
OP_GHCR_ITEM=$OP_GHCR_ITEM
OP_GHCR_FIELD=$OP_GHCR_FIELD
GITHUB_TOKEN=$GITHUB_TOKEN
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_MASTER_KEY=$RAILS_MASTER_KEY

# Match Tradia's credential order: an explicit Kamal password, a GitHub token,
# or a named 1Password field. Set the three OP_* selectors in your shell.
KAMAL_REGISTRY_PASSWORD=$( if [ -n "$KAMAL_REGISTRY_PASSWORD" ]; then printf "%s" "$KAMAL_REGISTRY_PASSWORD"; elif [ -n "$GITHUB_TOKEN" ]; then printf "%s" "$GITHUB_TOKEN"; else op item get "$OP_GHCR_ITEM" --vault "$OP_VAULT" --fields "label=$OP_GHCR_FIELD" --reveal; fi )

# Rails already keeps this value in an ignored local file.
RAILS_MASTER_KEY=$( [ -n "$RAILS_MASTER_KEY" ] && printf "%s" "$RAILS_MASTER_KEY" || cat config/master.key )
